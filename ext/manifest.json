{
  "manifest_version": 3,
  "name": "watch-party-ext",
  "description": "See your favorite movies with your friends",
  "version": "1.0.1",
  "action": {
    "default_title": "Watch Party"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "js": [
        "utils/Logger.js",
        "scripts/videoStore.js",
        "scripts/videoPlayerGetter.js",
        "scripts/videoPlayerHandler.js",
        "scripts/webSocketService.js",
        "scripts/content.js"
      ],
      "matches": [
        "https://www.primevideo.com/*",
        "https://*.crunchyroll.com/*"
      ],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}